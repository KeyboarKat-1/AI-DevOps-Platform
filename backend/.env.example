# Example environment variables for AI DevOps Platform

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/ai_devops

# Secret used for JWT token signing and other security features
SECRET_KEY=your_secret_key_here

# OpenAI API key used for incident analysis
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: model name to use for OpenAI analysis
OPENAI_MODEL=gpt-4o-mini
